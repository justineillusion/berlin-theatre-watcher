# Copie ce fichier en .env pour un run local (ne PAS committer .env).
# En prod (GitHub Actions), mets ces valeurs dans Settings > Secrets > Actions.

# Clé API Anthropic — https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Bot Telegram : écris à @BotFather sur Telegram, /newbot, il te donne le token.
TELEGRAM_BOT_TOKEN=123456789:AA...

# Ton chat_id : démarre une conversation avec ton bot (envoie-lui "hi"), puis
# lance `python -m src.get_chat_id` pour le récupérer.
TELEGRAM_CHAT_ID=123456789
